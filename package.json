{
  "name": "jiaoben",
  "version": "0.1.1",
  "description": "脚本管理器：导入、编写、运行 JS / Python 小工具脚本，支持手动、定时 cron、随应用启动、长驻自动拉起。引擎库零依赖；electron/ 目录提供 Electron 宿主适配层与面板 UI。",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./electron": "./electron/ipc.mjs",
    "./electron/preload": "./electron/preload.cjs",
    "./electron/ui/panel": "./electron/ui/panel.mjs",
    "./electron/ui/panel.css": "./electron/ui/panel.css"
  },
  "files": [
    "src",
    "electron",
    "README.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "script-manager",
    "electron",
    "cron",
    "daemon",
    "python",
    "javascript"
  ]
}
